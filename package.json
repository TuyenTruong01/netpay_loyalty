{
  "name": "netpay-loyalty-v1",
  "version": "1.0.0",
  "description": "Mobile-first USDC merchant network on Arc with on-chain APoint loyalty",
  "scripts": {
    "dev": "node ./node_modules/vite/bin/vite.js --host 0.0.0.0",
    "build": "node ./node_modules/vite/bin/vite.js build",
    "preview": "node ./node_modules/vite/bin/vite.js preview --host 0.0.0.0",
    "compile:contracts": "hardhat compile",
    "deploy:netpay:arc": "hardhat run scripts/deployNetPayV1.js --network arc",
    "test:netpay:v1": "hardhat run scripts/testNetPayV1Contracts.js"
  },
  "dependencies": {
    "@supabase/supabase-js": "latest",
    "@vitejs/plugin-react": "latest",
    "@walletconnect/ethereum-provider": "^2.17.2",
    "@walletconnect/modal": "^2.7.0",
    "lucide-react": "latest",
    "react": "latest",
    "react-dom": "latest",
    "vite": "latest"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-ethers": "^3.1.2",
    "dotenv": "^16.4.7",
    "hardhat": "^2.22.19",
    "pptxgenjs": "^4.0.1",
    "supabase": "^2.109.1"
  }
}
